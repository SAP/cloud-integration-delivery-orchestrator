_schema-version: "3.1.0"
ID: cpi-delivery-customer
extends: cpi-delivery

parameters:
  # --- Required ---
  app-host-prefix: "your-cpi-delivery-prefix"
  docker-image: "ghcr.io/sap/cloud-integration-delivery-orchestrator:latest"

  # --- Optional ---
  # db-service-plan: "standard"

# --- Optional: override module parameters ---
# modules:
#   - name: cpi-delivery
#     parameters:
#       memory: 2048M
#       instances: 2

# --- Optional: bind to existing service instances ---
# resources:
#   - name: cpi-delivery-uaa
#     parameters:
#       service-name: my-xsuaa-instance
#
#   - name: cpi-delivery-uaa-api
#     parameters:
#       service-name: my-xsuaa-apiaccess
#
#   - name: cpi-delivery-db
#     parameters:
#       service-name: my-postgresql-db
#
#   - name: cpi-delivery-dest
#     parameters:
#       service-name: my-destination-service
#
#   - name: cpi-delivery-conn
#     parameters:
#       service-name: my-connectivity-service
#
#   # Enable SAP Cloud Logging (requires cloud-logging entitlement)
#   - name: cpi-delivery-cls
#     active: true
