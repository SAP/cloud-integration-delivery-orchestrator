# Copy this file, rename it (e.g. my-landscape.mtaext), fill in your values, and deploy:
#   mbt build
#   cf deploy mta_archives/cloud-integration-delivery-orchestrator_1.0.0.mtar -e my-landscape.mtaext

_schema-version: "3.1.0"
ID: cloud-integration-delivery-orchestrator-customer
extends: cloud-integration-delivery-orchestrator

parameters:
  # --- Required ---
  app-host-prefix: "your-orchestrator-prefix"
  docker-image: "ghcr.io/sap/cloud-integration-delivery-orchestrator:latest"

  # --- Optional ---
  # db-service-plan: "standard"

# --- Optional: override module parameters ---
# modules:
#   - name: cloud-integration-delivery-orchestrator
#     parameters:
#       memory: 2048M
#       instances: 2

# --- Optional: bind to existing service instances ---
# resources:
#   - name: cloud-integration-delivery-orchestrator-uaa
#     parameters:
#       service-name: my-xsuaa-instance
#
#   - name: cloud-integration-delivery-orchestrator-uaa-api
#     parameters:
#       service-name: my-xsuaa-apiaccess
#
#   - name: cloud-integration-delivery-orchestrator-db
#     parameters:
#       service-name: my-postgresql-db
#
#   - name: cloud-integration-delivery-orchestrator-dest
#     parameters:
#       service-name: my-destination-service
#
#   - name: cloud-integration-delivery-orchestrator-conn
#     parameters:
#       service-name: my-connectivity-service

# --- Optional services (default: inactive in mta.yaml) ---
# Uncomment to enable. Requires the corresponding entitlement in the subaccount.

#   # Connectivity Service — required for on-premise system access via Cloud Connector
#   - name: cloud-integration-delivery-orchestrator-conn
#     active: true

#   # SAP Cloud Logging — observability (traces, metrics, logs)
#   - name: cloud-integration-delivery-orchestrator-cls
#     active: true

#   # SAP Alert Notification Service — delivery event notifications (Email, Slack, Teams)
#   - name: cloud-integration-delivery-orchestrator-ans
#     active: true
